# Sao chép thành .env.local (web/admin) hoặc .env (server). KHÔNG commit file thật.

# Frontend (NEXT_PUBLIC_* sẽ lộ ra trình duyệt: không đặt secret ở đây)
NEXT_PUBLIC_API_URL=http://localhost:4000

# Backend
PORT=4000
DATABASE_URL=postgres://user:password@localhost:5432/greenseed
REDIS_URL=redis://:password@localhost:6379
JWT_SECRET=change-me
SENTRY_DSN=
