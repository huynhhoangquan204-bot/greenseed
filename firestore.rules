rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // ĐỔI email admin bên dưới cho trùng VITE_ADMIN_EMAIL
    function admin() { return request.auth != null && request.auth.token.email == 'admin@gmail.com'; }
    match /plants/{id} { allow read: if true; allow write: if admin(); }
    match /announcements/{id} { allow read: if true; allow write: if admin(); }
    match /orders/{id} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || admin());
      allow update, delete: if admin();
    }
    match /chats/{uid} {
      allow read, write: if request.auth != null && (request.auth.uid == uid || admin());
      match /messages/{m} {
        allow read: if request.auth != null && (request.auth.uid == uid || admin());
        allow create: if request.auth != null && ((request.auth.uid == uid && request.resource.data.from == 'user') || admin());
      }
    }
  }
}
